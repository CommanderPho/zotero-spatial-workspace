startup-begin = 空间工作区正在加载
startup-finish = 空间工作区已就绪
prefs-title = 空间工作区
board-tab-title = 空间工作区
board-status-empty = 面板上还没有条目。在文献库中右键点击条目，选择“添加到空间工作区”。
board-status-count = 面板上有 { $count } 个条目
board-status-filtered = 已筛选：显示 { $visible } / { $total } 个条目
board-removed = 已从面板移除 { $count } 个条目（它们仍保留在 Zotero 中）
board-added = 已添加 { $count } 个条目到面板
board-nothing-selected = 未选择任何文献库条目
board-toolbar-arrange = 自动排列
board-toolbar-arrange-tooltip = 在文件夹区域内以整齐网格排列卡片
board-toolbar-fit = 适应视图
board-toolbar-fit-tooltip = 缩放以显示整个面板
board-toolbar-notes = 笔记
board-toolbar-notes-tooltip = 显示或隐藏笔记卡片
board-filter-clear = 清除筛选
board-filter-clear-tooltip = 清除筛选并显示所有卡片
board-filter-tooltip = 临时隐藏不匹配的卡片。可用条件：title:、author:、type:、kind:、added:、modified:、read:，支持日期（2024-05-01、>7d、never、any）。按 Esc 清除。
